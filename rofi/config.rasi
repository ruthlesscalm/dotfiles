configuration {
    modi: [drun, run, window, filebrowser];
    show-icons: false;
    font: "MesloLGS Nerd Font Mono 13";

    case-sensitive: false;
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";
}

* {
    bg:           #2f343f;
    bg-alt:       #252830;
    bg-hover:     #393e49;
    fg:           #cfcfd0;
    active:       #6b7a68;
    fg-dim:       #676E7D;
    accent:       #6d7179;
    border:       #595d65;
    urgent:       #E53935;
    prompt:       #fab387;

    background-color: transparent;
    text-color:       @fg;
}

/* Window Frame */
window {
    location:         center;
    anchor:           center;
    width:            45%;
    border:           2px;
    border-color:     @border;
    border-radius:    8px;
    background-color: @bg;
}

/* Main Box (Search at Bottom Layout) */
mainbox {
    children:         [ listview, inputbar ];
    background-color: @bg;
    padding:          12px;
    spacing:          10px;
}

/* Search Bar (Anchored at Bottom) */
inputbar {
    children:         [ prompt, entry ];
    padding:          8px 12px;
    background-color: @bg-alt;
    border:           1px;
    border-color:     @border;
    border-radius:    6px;
}

prompt {
    text-color:       @prompt;
    padding:          0px 10px 0px 0px;
}

entry {
    placeholder:      "Find files, apps, or windows…";
    placeholder-color:@fg-dim;
    text-color:       @fg;
}

/* Results List */
listview {
    lines:            8;
    spacing:          4px;
    background-color: @bg-alt;
    border:           1px;
    border-color:     @border;
    border-radius:    6px;
    padding:          8px;
    scrollbar:        false;
}

/* Item Selection Styling */
element {
    padding:          6px 8px;
    border-radius:    4px;
    text-color:       @fg;
}

element selected {
    background-color: @bg-hover;
    text-color:       @fg;
    border:           1px;
    border-color:     @accent;
}
element selected.active {
    background-color: @active;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
}

/* Strip Alternate Row Highlights */
element normal.normal,
element alternate.normal,
element normal.active,
element alternate.active,
element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color:       @fg;
}
