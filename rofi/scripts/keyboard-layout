#!/usr/bin/env bash

set -euo pipefail

SCRIPT="$HOME/.config/scripts/toggle-keyboard-layout"

layout=$(
    printf "qwerty\npine\ngallium\n" |
    rofi -dmenu \
         -i \
         -p "Keyboard Layout"
)

# Exit if no selection was made (e.g., user pressed Escape)
[[ -z "$layout" ]] && exit 0

# Run the script directly — the script itself will handle pkexec inside
"$SCRIPT" "$layout"
