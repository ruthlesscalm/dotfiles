[global]
    # --- DISPLAY ---
    monitor = 0
    follow = mouse
    
    # Position: Top Right with some padding
    width = 320
    height = (0, 300)
    origin = top-right
    offset = (30, 50)
    
    # Shrink window if content is smaller
    shrink = yes
    
    # Transparency (0-100) - Slight transparency for that modern Linux feel
    transparency = 5
    
    # Padding and Spacing
    separator_height = 2
    padding = 15
    horizontal_padding = 15
    
    # Border (Frame)
    frame_width = 1
    # Neutral grey border (Subtle)
    frame_color = "#585b70"
    
    # Separator between notifications
    separator_color = frame
    
    # --- TEXT ---
    # Increased font size to 12 (was 10)
    font = MesloLGS Nerd Font Mono 14
    
    line_height = 4
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    
    # --- ICONS ---
    enable_recursive_icon_lookup = true
    
    # Make sure you ran the sudo apt install command above!
    icon_theme = Papirus-Dark
    
    icon_position = left
    max_icon_size = 48 

    # --- MOUSE ---
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

# --- COLORS (Minimal / Neutral) ---

[urgency_low]
    # Dark grey background, Grey text
    background = "#181825"
    foreground = "#a6adc8"
    frame_color = "#313244"
    timeout = 5

[urgency_normal]
    # Dark grey background, White text (Standard)
    background = "#1e1e2e"
    foreground = "#ffffff"
    # Subtle light grey border
    frame_color = "#585b70"
    timeout = 10

[urgency_critical]
    # Dark background, Red text for danger, but keep border minimal
    background = "#1e1e2e"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 0
