{
    "Full arrow function": {
        "prefix": "arfn",
        "body": [
            "const ${1:fn} = (${2}) => {",
            "  ${3}",
            "}"
        ],
        "description": "Full arrow function"
    },

    "Half arrow function": {
        "prefix": "harfn",
        "body": [
            "(${1}) => {",
            "  ${2}",
            "}"
        ],
        "description": "Arrow function without const/="
    },

    "Short arrow function": {
        "prefix": "sarfn",
        "body": [
            "(${1}) => ${2}"
        ],
        "description": "Short one-line arrow function"
    },

    "console.log": {
        "prefix": "colog",
        "body": [
            "console.log(${1})"
        ],
        "description": "console.log"
    }
}
