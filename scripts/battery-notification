#!/usr/bin/env bash

export PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$HOME/.local/bin"

CURRENT_PID=$$
for pid in $(pgrep -f "battery-canary"); do
    if [ "$pid" != "$CURRENT_PID" ]; then
        kill "$pid" 2>/dev/null
    fi
done

STATE_FILE_20="/tmp/.bat1_warn_20"
STATE_FILE_10="/tmp/.bat1_warn_10"

while true; do
    BAT_INFO=$(upower -i /org/freedesktop/UPower/devices/battery_BAT1)
    
    PERCENTAGE=$(echo "$BAT_INFO" | awk '/percentage:/ {print $2}' | tr -d '%')
    IS_CHARGING=$(echo "$BAT_INFO" | grep -q "state:\s*charging" && echo "yes" || echo "no")

    if [[ -z "$PERCENTAGE" ]]; then
        sleep 60
        continue
    fi

    if [ "$IS_CHARGING" = "no" ]; then
        if [ "$PERCENTAGE" -le 10 ]; then
            if [ ! -f "$STATE_FILE_10" ]; then
                dunstify -u critical -i battery-empty "Battery Dangerously Low" "BAT1 is at <b>${PERCENTAGE}%</b>.\nPlug in your charger immediately!"
                touch "$STATE_FILE_10"
            fi
        elif [ "$PERCENTAGE" -le 20 ]; then
            if [ ! -f "$STATE_FILE_20" ]; then
                dunstify -u normal -i battery-caution "Battery Low" "BAT1 is down to <b>${PERCENTAGE}%</b>."
                touch "$STATE_FILE_20"
            fi
        else
            rm -f "$STATE_FILE_20" "$STATE_FILE_10"
        fi
    else
        rm -f "$STATE_FILE_20" "$STATE_FILE_10"
    fi

    sleep 60
done
